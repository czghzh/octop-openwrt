#!/bin/sh /etc/rc.common
# Octop — self-hosted AI agent server (aarch64 / musl build).
#
# Installed by octop-openwrt. Standard OpenWrt procd service:
#   /etc/init.d/octop start|stop|restart|reload|enable|disable|status
#
# 进程由 procd 守护，意外退出会自动重启。

START=95
STOP=10
USE_PROCD=1

PROG=/overlay/start-octop.sh
LOGFILE=/overlay/octop-server.log
PIDFILE=/overlay/octop-server.pid

start_service() {
	if [ ! -x "$PROG" ]; then
		logger -t octop "launcher $PROG not found or not executable"
		return 1
	fi

	procd_open_instance
	# start-octop.sh 内部用 exec，因此 procd 追踪到的 PID 就是 python 进程本身
	procd_set_param command /bin/sh "$PROG"
	# 输出重定向到日志文件（日志量大，避免刷爆 logd 的环形缓冲）
	procd_set_param env OCTOP_LOG="$LOGFILE"
	# 崩溃自动重启：3600 秒内最多 5 次，每次间隔 5 秒
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	# 启动阶段（加载 ~190 个包）较慢，放宽观察窗口
	procd_set_param limits core="unlimited"
	procd_close_instance

	logger -t octop "service started (port from start-octop.sh, default 8088)"
}

stop_service() {
	# procd 会先发 SIGTERM 并等待；此处仅做兜底清理
	sleep 1
	PID=$(cat "$PIDFILE" 2>/dev/null)
	if [ -n "$PID" ] && [ -d "/proc/$PID" ]; then
		logger -t octop "force killing leftover pid $PID"
		kill -9 "$PID" 2>/dev/null
	fi
	rm -f "$PIDFILE"
}

reload_service() {
	restart
}

EXTRA_COMMANDS="health log"
EXTRA_HELP="	health	Print the server health endpoint
	log	Tail the server log"

health() {
	PORT=$(sed -n 's/.*OCTOP_PORT="\${OCTOP_PORT:-\([0-9]*\)}".*/\1/p' "$PROG" 2>/dev/null)
	PORT=${PORT:-8088}
	if command -v wget >/dev/null 2>&1; then
		wget -qO- --timeout=8 "http://127.0.0.1:$PORT/api/health" 2>/dev/null || echo "(no response on port $PORT)"
	else
		curl -s --max-time 8 "http://127.0.0.1:$PORT/api/health" 2>/dev/null || echo "(no response on port $PORT)"
	fi
	echo
}

log() {
	tail -n 40 "$LOGFILE" 2>/dev/null || echo "(no log at $LOGFILE)"
}
